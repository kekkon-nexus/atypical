  "devDependencies": {
    "@kekkon-nexus/config": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "lefthook": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
