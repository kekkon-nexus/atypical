{
  "name": "atypical",
  "private": true,
  "workspaces": {
    "packages": [
      "benches",
      "npm"
    ],
    "catalogs": {
      "dev": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21",
        "@kekkon-nexus/config": "4.0.2",
        "@types/bun": "latest",
        "@types/node": "^26.6.5",
        "lefthook": "2.2.2",
        "oxfmt": "0.73.0",
        "oxlint": "1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "tombi": "1.8.8",
        "typescript": "^7.0.2",
        "v8r": "6.1.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check": "lefthook run check",
    "fix": "lefthook run fix",
    "test": "lefthook run test",
    "build": "cargo build --release -p atypical-commit",
    "bench": "sh benches/latency.sh"
