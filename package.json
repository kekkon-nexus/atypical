{
  "name": "atypical",
  "private": true,
  "workspaces": {
    "packages": [
      "benches",
      "docs",
      "npm"
    ],
    "catalog": {
      "compressorjs": "^1.4.0",
      "hast-util-to-jsx-runtime": "^2.3.6",
      "hono": "^4.12.14",
      "next-themes": "^0.4.6",
      "takumi-js": "^2.18.2",
      "twgl.js": "^7.0.0",
      "waku": "1.0.0-rc.3"
    },
    "catalogs": {
      "fumadocs": {
        "fumadocs-core": "16.17.8",
        "fumadocs-mdx": "15.4.8",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7"
      },
      "shadcn": {
        "@base-ui/react": "^1.8.0",
        "@remixicon/react": "^4.9.0",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
      },
      "react": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-server-dom-webpack": "^19.2.8"
      },
      "dev": {
        "@cloudflare/vite-plugin": "^1.65.0",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21",
        "@kekkon-nexus/config": "4.0.2",
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "latest",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.6.5",
        "naga-wasm": "^30.1.0",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "oxlint-tsgolint": "^7.0.2004",
        "tailwindcss": "^4.3.3",
        "tombi": "1.9.6",
        "typescript": "^7.0.2",
        "v8r": "6.1.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
        "vite-plus": "^1.3.0",
        "wrangler": "^4.153.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "bump": "bun scripts/bump.ts",
    "check": "bun run --parallel --no-exit-on-error check:*",
    "check:cargo": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check:tombi": "tombi format --check && tombi lint",
    "check:v8r": "v8r '**/*.{json,yml,yaml}'",
    "check:vp": "vp check",
    "fix": "bun run --sequential --no-exit-on-error fix:*",
    "fix:cargo": "cargo clippy --workspace --all-targets --all-features --fix --allow-staged --allow-dirty && cargo fmt --all",
    "fix:tombi": "tombi format && tombi lint",
    "fix:vp": "vp check --fix",
    "test": "bun run --sequential --no-exit-on-error test:*",
    "test:cargo": "cargo nextest run --workspace --all-targets --all-features --locked",
    "test:cargo:doc": "cargo test --doc --workspace --all-features --locked",
    "docs": "bun --cwd ./docs run dev",
    "build": "cargo build --release -p atypical-commit",
    "bench": "sh benches/latency.sh"
  },
  "devDependencies": {
    "@kekkon-nexus/config": "catalog:dev",
    "@types/bun": "catalog:dev",
    "@types/node": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "tombi": "catalog:dev",
    "typescript": "catalog:dev",
    "v8r": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "overrides": {
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "vite": "catalog:dev"
  },
  "patchedDependencies": {
    "waku@1.0.0-rc.3": "patches/waku@1.0.0-rc.3.patch"
  }
}
