{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@kekkon-nexus/config/ts", "@kekkon-nexus/config/ts/strict"],
  "compilerOptions": {
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["dist"]
}
